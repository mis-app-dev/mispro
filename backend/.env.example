APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_mis
DB_USERNAME=root
DB_PASSWORD=

ADMIN_EMAIL=admin@mis-mdo.sch.id
ADMIN_USERNAME=Administrator
ADMIN_FULLNAME=Administrator
# Set your own strong password before running `php artisan db:seed`.
ADMIN_PASSWORD=

# /api/v1/sync/* requires SYNC_API_KEY, sent by the caller as the X-API-Key header
# (or Authorization: Bearer <key>). Generate a key with:
#   php -r "echo bin2hex(random_bytes(32));"
# SYNC_ALLOW_LOCAL=true additionally lets callers on this same machine that connect
# directly to PHP (loopback, no proxy headers) skip the key. Leave it off in production.
SYNC_API_KEY=
# Temporarily set to false while the report card system is updated to send the key;
# calls without the key are then allowed and logged in storage/logs. Set back to true.
SYNC_REQUIRE_KEY=true
SYNC_ALLOW_LOCAL=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Telescope is off unless enabled here. Keep it off in production.
TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
